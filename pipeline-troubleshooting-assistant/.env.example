# Pipeline Troubleshooting Assistant — Environment Variables Template
# Copy this file to .env and fill in the values before running docker compose up.
# NEVER commit .env to version control — it is git-ignored.

# ── PostgreSQL service ────────────────────────────────────────────────────────
# Database name created on first container start
POSTGRES_DB=pipeline_assistant

# Database superuser credentials (change these for non-local environments)
POSTGRES_USER=<your-db-user>
POSTGRES_PASSWORD=<your-db-password>

# ── Spring Boot datasource ────────────────────────────────────────────────────
# JDBC URL used by the backend; 'db' resolves to the postgres container hostname
DB_URL=jdbc:postgresql://db:5432/pipeline_assistant

# Must match POSTGRES_USER / POSTGRES_PASSWORD above
DB_USERNAME=<your-db-user>
DB_PASSWORD=<your-db-password>

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API
# For local development: http://localhost:5173
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
