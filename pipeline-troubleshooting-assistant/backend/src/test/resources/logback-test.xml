<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Pattern layout for test output — keeps test logs human-readable -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Suppress noise from Spring and Hibernate during tests -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- Show application logs at INFO so test failures are diagnosable -->
    <logger name="com.opsera" level="INFO"/>
</configuration>
