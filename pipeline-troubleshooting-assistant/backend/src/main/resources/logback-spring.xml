<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Pull the active Spring profile so it can be embedded as a custom field in JSON output -->
    <springProperty scope="context" name="activeProfile" source="spring.profiles.active" defaultValue="default"/>

    <!-- Local dev: human-readable pattern with correlation ID in brackets -->
    <springProfile name="local">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} [%X{correlationId:-no-corr-id}] - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <!-- All non-local profiles (dev, prod, staging, etc.): structured JSON for log aggregation -->
    <springProfile name="!local">
        <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <!-- app_name and environment appear in every JSON log line -->
                <customFields>{"app_name":"pipeline-assistant","environment":"${activeProfile}"}</customFields>
                <!-- MDC fields (correlationId) are included automatically by LogstashEncoder -->
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
        </root>
    </springProfile>

</configuration>
