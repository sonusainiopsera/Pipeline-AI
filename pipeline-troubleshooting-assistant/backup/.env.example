# ─── PostgreSQL connection settings ──────────────────────────────────────────
# Hostname of the PostgreSQL service (Docker Compose service name)
DB_HOST=db

# PostgreSQL port (default 5432)
DB_PORT=5432

# Database name to back up
DB_NAME=pipeline_assistant

# PostgreSQL username with SELECT privileges on all tables
DB_USER=pipeline_user

# PostgreSQL password — sourced from the main .env file in production
# Never hardcode a real password here
DB_PASSWORD=changeme

# ─── Backup schedule ─────────────────────────────────────────────────────────
# Cron expression controlling when nightly backups run (default: 02:00 UTC daily)
BACKUP_CRON_SCHEDULE=0 2 * * *

# ─── Retention policy ────────────────────────────────────────────────────────
# Number of days to retain backup files before automatic deletion (default: 30)
BACKUP_RETENTION_DAYS=30
