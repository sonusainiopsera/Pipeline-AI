# ─── PostgreSQL connection settings ──────────────────────────────────────────
# Hostname of the PostgreSQL service (Docker Compose service name)
DB_HOST=db

# PostgreSQL port (default 5432)
DB_PORT=5432

# Database name to back up
DB_NAME=pipeline_assistant

# PostgreSQL username with SELECT privileges on all tables
DB_USER=pipeline_user

# PostgreSQL password — sourced from the main .env file in production
# Never hardcode a real password here
DB_PASSWORD=changeme

# ─── Backup schedule ─────────────────────────────────────────────────────────
# Cron expression controlling when nightly backups run (default: 02:00 UTC daily)
BACKUP_CRON_SCHEDULE=0 2 * * *

# ─── Local retention policy ──────────────────────────────────────────────────
# Number of days to retain local backup files before automatic deletion (default: 30)
BACKUP_RETENTION_DAYS=30

# ─── Off-site S3 storage (optional) ─────────────────────────────────────────
# S3-compatible bucket name — required to enable off-site push
# Leave empty to skip off-site push
S3_BUCKET=

# S3 endpoint URL — required for non-AWS endpoints (MinIO, DigitalOcean Spaces, etc.)
# Leave empty for AWS S3 (uses default AWS endpoint for the region)
# Example (MinIO): http://minio:9000
S3_ENDPOINT=

# AWS region (default: us-east-1)
S3_REGION=us-east-1

# S3 access key — never commit a real key here
S3_ACCESS_KEY=

# S3 secret key — never commit a real secret here
S3_SECRET_KEY=

# Remote retention: number of days to keep backup objects in S3 (default: 90)
REMOTE_RETENTION_DAYS=90

# Timeout in seconds for each S3 push operation (default: 60)
PUSH_TIMEOUT_SECONDS=60

# Set to "true" to automatically create the S3 bucket if it does not exist
# (useful for MinIO dev setups; leave false in production)
BACKUP_S3_AUTO_CREATE_BUCKET=false

# ─── Restore verification schedule ──────────────────────────────────────────
# Cron expression for weekly restore verification (default: Sunday 04:00 UTC)
VERIFY_CRON_SCHEDULE=0 4 * * 0
